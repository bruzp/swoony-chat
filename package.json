  "scripts": {
    "dev": "node scripts/run-bin.mjs vite",
    "build": "node scripts/run-bin.mjs vite build",
    "preview": "node scripts/run-bin.mjs vite preview",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:web": "node scripts/run-bin.mjs vitest run -c vitest.web.config.ts",
    "test:worker": "node scripts/run-bin.mjs vitest run -c vitest.worker.config.ts --max-workers=1 --no-isolate",
    "test": "npm run test:web && npm run test:worker",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "deploy": "npm run build && wrangler deploy",
    "format:check": "prettier --check ."
  }
