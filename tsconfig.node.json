{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "paths.ts",
    "vite.config.ts",
    "vitest.worker.config.ts",
    "vitest.web.config.ts",
    "scripts/legal",
    "scripts/site",
    "scripts/loadtest.ts",
    "vite-plugins"
  ]
}
